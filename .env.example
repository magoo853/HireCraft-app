# Optional. When unset, the app runs a high-quality rules/template engine
# so every feature still demonstrably works.
AI_API_KEY=
# OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
AI_API_BASE=
# Defaults to gpt-4o-mini
AI_MODEL=

# ---- Military verification (6-month free trial) ----
# Leave unset to use the attestation fallback. Set to enable hosted verification.
# ID.me (OAuth): get these from the ID.me developer portal (developers.id.me)
#   1. Register an app, request the "military" group scope
#   2. Set the redirect URI to: <APP_URL>/api/verify/idme/callback
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
# "true" to use the ID.me sandbox (api.idmelabs.com) for testing
IDME_SANDBOX=
# SheerID (REST v2): from your SheerID program dashboard (developer.sheerid.com)
#   1. Create a program for the military segment (active military + veterans)
#   2. Copy the program ID and generate an API token (Bearer)
#   3. If you enable completion notifications, point the webhook at:
#      <APP_URL>/api/verify/sheerid/webhook
SHEERID_API_TOKEN=
SHEERID_PROGRAM_ID=
# Public base URL of this deployment (used to build callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Launch date for the 14-day launch promo (ISO date, e.g. 2026-11-15).
# The "try everything free for 2 weeks" offer shows for 30 days after this date.
# Leave unset to hide the promo.
NEXT_PUBLIC_LAUNCH_DATE=
