# ResumeRoadmap environment variables.
# This file lists ONLY the variables the code actually reads (kept in sync
# with the code by hc-tools/security-config-check.mjs).
# In production these are set in the Vercel project settings — never commit real values.

# ---- AI (required for live AI) ----
# The OPERATOR'S server-side Google Gemini key (Google AI Studio).
# Users never supply their own key, and the key is never exposed to the client.
# When unset, /api/ai runs the built-in deterministic fallback engine instead,
# so every feature still works.
AI_API_KEY=
# Optional override: any OpenAI-compatible endpoint.
# Default: https://generativelanguage.googleapis.com/v1beta/openai
AI_API_BASE=
# Optional override: primary model. Default: gemini-3.8-flash
# (the code then falls back to gemini-3.6-flash, then gemini-3.5-flash-lite).
AI_MODEL=

# ---- Job search sources (optional) ----
# Free key from developer.usajobs.gov. When unset, the USAJobs source is
# skipped and Discover uses Remotive / Himalayas / Arbeitnow only.
USAJOBS_API_KEY=
# Email registered with the USAJobs developer account (sent as the User-Agent).
USAJOBS_EMAIL=
# Adzuna app credentials (developer.adzuna.com). When unset, the Adzuna
# source is skipped the same way.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Launch promo (optional) ----
# Launch date for the 2-week free trial promo (ISO date, e.g. 2026-11-15).
# The web paywall shows the launch-trial banner for 30 days after this date.
# Leave unset to hide the promo.
NEXT_PUBLIC_LAUNCH_DATE=

# ---- POST-LAUNCH ONLY: military verification (fail-closed in v1) ----
# lib/verification.ts implements the full ID.me / SheerID flow, but the
# master gate below keeps it OFF: unless MILITARY_VERIFICATION_ENABLED is
# exactly "true" AND a provider's credentials are present, every verify
# route returns a controlled 503 / grants nothing. Do NOT enable for v1.
MILITARY_VERIFICATION_ENABLED=
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
# "true" to use the ID.me sandbox (api.idmelabs.com) — post-launch testing only.
IDME_SANDBOX=
SHEERID_API_TOKEN=
SHEERID_PROGRAM_ID=
# SheerID account Secret Token (MySheerID -> API Access). Keys the
# X-SheerID-Signature HMAC check on /api/verify/sheerid/webhook; the
# webhook rejects unsigned or badly signed deliveries (401) and grants
# nothing by itself.
SHEERID_WEBHOOK_SECRET=
# Public base URL used to build the providers' callback URLs.
NEXT_PUBLIC_APP_URL=
